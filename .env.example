# Local-only authenticated API. Keep loopback binding; HTTP Basic requires TLS for remote hosting.
HOST=127.0.0.1
PORT=8787
# DATA_DIR=/private/tmp/teamforge-data
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Laptop default=1; increase to 2+ only if GPU memory permits concurrent model runs.
TEAMFORGE_MAX_CONCURRENT_AGENTS=1
# Required for local Git imports; set to trusted parent directories separated by : on macOS/Linux
TEAMFORGE_IMPORT_ROOTS=/Users/you/Projects
# Remote HTTPS repo imports disabled by default
TEAMFORGE_ALLOW_REMOTE_GIT=1
# Optional Docker image, must be locally available; network is disabled in sandbox
TEAMFORGE_DOCKER_IMAGE=node:22-alpine
DOCKER_IMAGE=node:22-alpine

# Legacy Codex CLI adapter is retained for compatibility tests; secured API execution is disabled.

# Authentication is always enabled. Bootstrap values are read only when users.json does not exist.
# Leave password unset to generate a random password printed once by the API.
TEAMFORGE_ADMIN_USER=admin
# TEAMFORGE_ADMIN_PASSWORD=choose-a-unique-password-of-at-least-12-characters
TEAMFORGE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TEAMFORGE_MAX_GLOBAL_EXECUTIONS=1
TEAMFORGE_MAX_PROJECT_EXECUTIONS=1
TEAMFORGE_MAX_INFERENCE_REQUESTS=1
TEAMFORGE_MAX_REPAIR_ATTEMPTS=2

# Local model: separate loading/queue wait, stalled-stream timeout, and maximum response time.
TEAMFORGE_OLLAMA_START_TIMEOUT_MS=180000
TEAMFORGE_OLLAMA_IDLE_TIMEOUT_MS=90000
TEAMFORGE_OLLAMA_RESPONSE_TIMEOUT_MS=600000

# Explicit opt-in: automatically commit and push after final human QA approval
TEAMFORGE_AUTO_PUBLISH=0
TEAMFORGE_PUBLISH_BRANCH=develop
# Optional commit identity (default TeamForge <workspace@teamforge.invalid>)
# TEAMFORGE_GIT_AUTHOR_NAME=Your Name
# TEAMFORGE_GIT_AUTHOR_EMAIL=you@example.com
